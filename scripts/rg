#!/bin/bash
# Summary: Smart wrapper for rg (opens interactive fzf search -> $EDITOR when run with no args)
#
# NOTE: This script is a wrapper around the 'rg' (ripgrep) CLI tool.
# For this wrapper to intercept 'rg' calls, ~/scripts must appear BEFORE
# the real 'rg' binary's directory (e.g., /usr/bin or /usr/local/bin) in PATH.

# Find the real rg binary in PATH (skipping this wrapper script itself)
self="$(readlink -f "${BASH_SOURCE[0]}")"
real_rg=""
for candidate in $(type -ap rg); do
    if [ "$(readlink -f "$candidate")" != "$self" ]; then
        real_rg="$candidate"
        break
    fi
done

if [ -z "$real_rg" ]; then
    echo "Error: 'rg' (ripgrep) is not installed (https://github.com/BurntSushi/ripgrep)."
    exit 1
fi

# When called with no arguments in an interactive terminal, launch live fzf search
if [ $# -eq 0 ] && [ -t 0 ]; then
    if command -v fzf >/dev/null 2>&1; then
        rg_prefix="\"$real_rg\" --column --line-number --no-heading --color=always --smart-case"

        preview_cmd='awk -v target={2} "{
            if (NR == target) printf \"\033[1;33m%4d > %s\033[0m\n\", NR, \$0;
            else printf \"\033[0;90m%4d |\033[0m %s\n\", NR, \$0;
        }" {1}'

        selected="$(
            fzf --ansi \
                --disabled \
                --prompt="rg > " \
                --delimiter=":" \
                --bind="start:reload:$rg_prefix {q} || true" \
                --bind="change:reload:sleep 0.05; $rg_prefix {q} || true" \
                --preview="$preview_cmd" \
                --preview-window="right:60%:wrap:+{2}-/2"
        )"

        if [ -n "$selected" ]; then
            file="$(echo "$selected" | cut -d: -f1)"
            line="$(echo "$selected" | cut -d: -f2)"
            exec "${EDITOR:-vim}" "+$line" "$file"
        fi
        exit 0
    fi
fi

# If --help is requested, show wrapper info before the standard rg --help
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    echo "rg (dotfiles wrapper -> $real_rg)"
    echo "  Run 'rg' with no arguments to live-search files with fzf and open matches in \$EDITOR (${EDITOR:-vim})."
    echo "  Any arguments are forwarded directly to $real_rg:"
    echo
fi

exec "$real_rg" "$@"
