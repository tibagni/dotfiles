#!/bin/bash
# Summary: Interactive live ripgrep search that opens matches in $EDITOR

function show_help {
    echo "rgi - Interactive live ripgrep search (rg + fzf + \$EDITOR)"
    echo
    echo "Searches file contents in the current directory in real time using 'ripgrep'"
    echo "as you type in 'fzf', previews the surrounding file context with the matching"
    echo "line highlighted, and opens the selected match in \$EDITOR (${EDITOR:-vim})"
    echo "at that exact line number."
    echo
    echo "Usage:"
    echo "  rgi                  Start interactive live search in current directory"
    echo "  rgi <initial-query>  Start live search pre-filled with <initial-query>"
    echo "  rgi -h, --help       Show this help message"
}

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    show_help
    exit 0
fi

for cmd in rg fzf; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Error: '$cmd' is required to run rgi."
        exit 1
    fi
done

initial_query="$*"
rg_prefix="rg --column --line-number --no-heading --color=always --smart-case"

preview_cmd='awk -v target={2} "{
    if (NR == target) printf \"\033[1;33m%4d > %s\033[0m\n\", NR, \$0;
    else printf \"\033[0;90m%4d |\033[0m %s\n\", NR, \$0;
}" {1}'

selected="$(
    fzf --ansi \
        --disabled \
        --query "$initial_query" \
        --prompt="rg > " \
        --delimiter=":" \
        --bind="start:reload:$rg_prefix {q} || true" \
        --bind="change:reload:sleep 0.05; $rg_prefix {q} || true" \
        --preview="$preview_cmd" \
        --preview-window="right:60%:wrap:+{2}-/2"
)"

if [ -n "$selected" ]; then
    file="$(echo "$selected" | cut -d: -f1)"
    line="$(echo "$selected" | cut -d: -f2)"
    "${EDITOR:-vim}" "+$line" "$file"
fi
