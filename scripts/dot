#!/bin/bash
# Summary: Manage and edit dotfiles from anywhere (fzf + $EDITOR + lazygit)

scripts_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
dotfiles_dir="$(cd "$scripts_dir/.." && pwd)"

function list_files {
    git -C "$dotfiles_dir" ls-files --cached --others --exclude-standard | sort
    if [ -f "$HOME/local_zshrc" ]; then
        echo "~/local_zshrc"
    fi
    if [ -f "$HOME/.tmux.local.conf" ]; then
        echo "~/.tmux.local.conf"
    fi
}

function resolve_dotfile_path {
    local item="$1"
    if [[ "$item" == "~/"* ]]; then
        echo "$HOME/$(basename "$item")"
    else
        echo "$dotfiles_dir/$item"
    fi
}

function show_help {
    echo "dot - Manage and edit your dotfiles from any directory"
    echo
    echo "Repository: $dotfiles_dir"
    echo
    echo "Usage:"
    echo "  dot                          Interactive fzf file picker -> open in \$EDITOR (${EDITOR:-vim})"
    echo "  dot <query>                  Open matching dotfile or local override (e.g., 'dot local')"
    echo "  dot -l, --list, list         Show environment info, active symlinks, and installed tools"
    echo "  dot -g, --git, git           Open lazygit inside $dotfiles_dir"
    echo "  dot -s, --status, status     Show git status of dotfiles"
    echo "  dot -d, --diff, diff         Show git diff of uncommitted dotfile changes"
    echo "  dot -i, --install, install   Run install.sh"
    echo "  dot -u, --update, update     Run install.sh -u (git pull --ff-only + install)"
    echo "  dot -h, --help, help         Show this help message"
}

function pick_and_edit {
    local query="$1"
    if ! command -v fzf >/dev/null 2>&1; then
        echo "Available files in $dotfiles_dir:"
        list_files
        exit 1
    fi

    local preview_cmd="f={}; case \"\$f\" in \"~/\"*) f=\"$HOME/\$(basename \"\$f\")\" ;; *) f=\"$dotfiles_dir/\$f\" ;; esac; nl -ba \"\$f\""
    local selected
    selected="$(
        list_files | fzf \
            --query="$query" \
            --select-1 \
            --exit-0 \
            --prompt="dotfiles > " \
            --preview="$preview_cmd" \
            --preview-window="right:65%:wrap"
    )"

    if [ -n "$selected" ]; then
        exec "${EDITOR:-vim}" "$(resolve_dotfile_path "$selected")"
    fi
}

case "$1" in
    -h|--help|help)
        show_help
        ;;
    -l|--list|list)
        exec "$dotfiles_dir/install.sh" --list
        ;;
    -g|--git|git)
        if command -v lazygit >/dev/null 2>&1; then
            exec lazygit -p "$dotfiles_dir"
        else
            git -C "$dotfiles_dir" status
        fi
        ;;
    -s|--status|status)
        git -C "$dotfiles_dir" status -sb
        ;;
    -d|--diff|diff)
        git -C "$dotfiles_dir" diff
        ;;
    -i|--install|install)
        exec "$dotfiles_dir/install.sh"
        ;;
    -u|--update|update)
        exec "$dotfiles_dir/install.sh" -u
        ;;
    "")
        pick_and_edit ""
        ;;
    *)
        if [ -f "$dotfiles_dir/$1" ]; then
            exec "${EDITOR:-vim}" "$dotfiles_dir/$1"
        else
            pick_and_edit "$*"
        fi
        ;;
esac
